# Copy to .env and fill in ONE provider. Never commit .env.
LLM_PROVIDER=gemini            # gemini | anthropic | template (no AI)
GEMINI_API_KEY=paste-your-key  # free key: https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-3.5-flash-lite
# ANTHROPIC_API_KEY=paste-your-key
# ANTHROPIC_MODEL=claude-haiku-5-5
LLM_RPM=10                     # requests per minute: stay under your plan's limit

# PostgreSQL connection (database with the Olist star schema from complaint-cost-engine)
PGHOST=localhost
PGUSER=postgres
PGDATABASE=complaint_cost
# PGPASSWORD=your-password
